# Copy to .env at the repo root; migrations, seeds, ingest and `pnpm dev` all read it.
# Never commit real values. On Vercel, set these in Project Settings → Environment Variables.

# Supabase Postgres connection string (use the pooled "transaction" URL for the web app,
# the direct/session URL for migrations).
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Supabase project (admin auth). Dashboard → Connect → App Frameworks, or Project Settings → API Keys.
# The publishable key (sb_publishable_…) is safe in the browser: every table has RLS with no policies.
# The legacy anon key also works here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated emails allowed into /admin. Empty means nobody (fails closed).
ADMIN_EMAILS=

# Ticketmaster Discovery API (M3)
TICKETMASTER_API_KEY=

# User agent sent by every ingest adapter (contact URL, not a personal email)
INGEST_USER_AGENT=CurtainlyBot/0.1 (+https://github.com/TonyQ032/curtainly)

# Geocoding (venue addresses → coordinates) via OpenStreetMap Nominatim. Set to "off" to stop all lookups.
GEOCODER=nominatim
