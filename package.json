{
  "name": "curtainly",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @curtainly/web dev",
    "build": "pnpm --filter @curtainly/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @curtainly/shared db:generate",
    "db:migrate": "pnpm --filter @curtainly/shared db:migrate",
    "ingest": "pnpm --filter @curtainly/ingest start",
    "db:seed": "pnpm --filter @curtainly/shared db:seed"
  },
  "devDependencies": {
    "prettier": "^3.10.0",
    "typescript": "~6.0.3"
  }
}
